---
interface Props {
    buttons?: ("home" | "essays" | "projects")[];
}

const { buttons = ["home", "essays", "projects"] } = Astro.props;
---

<style>
    #topbar {
        display: flex;
        justify-content: left;
        align-items: center;
        gap:50px
    }
    
</style>

<div id="topbar" >
    {buttons.includes("home") && (
        <a class="topbar-button" href="/hello">
            <h1> > ~ </h1>
        </a>
    )}
    {buttons.includes("essays") && (
        <a class="topbar-button" href="/essays">
            <h1> essays </h1>
        </a>
    )}
    {buttons.includes("projects") && (
        <a class="topbar-button" href="/projects">
            <h1> projects </h1>
        </a>
    )}
</div>
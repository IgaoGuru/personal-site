---
const onlyHome = Astro.props.onlyHome;
---

<style>
    #topbar {
        display: flex;
        justify-content: left;
        align-items: center;
        gap:50px
    }
    
</style>

<div id="topbar" >
    {onlyHome ? (
        <a class="topbar-button" href="/hello">
            <h1> > ~ </h1>
        </a>
    ) : (
        <a class="topbar-button" href="/hello">
            <h1> > ~ </h1>
        </a>
    
    <a class="topbar-button" href="/essays">
        <h1> essays </h1>
    </a>
    <a class="topbar-button" href="/projects">
        <h1> projects </h1>
    </a>
    )}
</div>
---
import Topbar from './Topbar.astro';
interface Props {
    buttons?: ("home" | "essays")[];
}

const { buttons } = Astro.props;
---

<style>
    .mainframe {
        width: 50%;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    #main {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    @media screen and (max-width: 1024px) {
        .mainframe {
            width: 90%;
        }
    }
</style>

<div class="mainframe">
    <Topbar buttons={buttons} />
    <div id="main">
        <slot />
    </div>
</div>
---
import Topbar from './Topbar.astro';
const onlyHome = Astro.props.onlyHome;
---

<style>
    .mainframe {
        width: 50%;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
    }
</style>

<div class="mainframe">
    <Topbar onlyHome={onlyHome} />
    <div id="main">
        <slot />
    </div>
</div>
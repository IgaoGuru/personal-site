---
import Mainframe from "../components/Mainframe.astro";
import Layout from "../layouts/Layout.astro";
import { marked } from "marked";
import pfp from "../assets/pfp.png";
---

<head>
    <title>Unbounded Temperance</title>
</head>
<body>
    <Layout>
        <Mainframe>
            <h1>Unbounded Temperance</h1>
            <div style="display: flex; flex-wrap: nowrap; align-items: stretch; gap: 1rem;">
                <!-- pfp -->
                <div>
                    <img src={pfp.src} alt="Igor" />
                </div> 
            </div>

            <p> Hi! I'm Igor. I like computers and bossa nova.</p>
            <p>
                I'm currently in Rio de Janeiro, starting a film distribution company.
            </p>
            <p>
                Before that, I was founding team at <a
                    href="https://www.teachy.com">Teachy</a
                > at 18: a startup for helping k-12 educators. I left right after we raised a Series A from Reach Capital and GoodWater Capital
            </p>
            <p>
                feel free to look around and take anything you like. Just
                say hi if you do :) <br /><br /> You can reach me at igor [at] falso.net
                or on <a href="https://x.com/1xfalso/">twitter</a>
            </p>

            <!-- blinkies -->
            <div style="display: flex; flex-direction: row; gap: 1rem; margin-top: 5rem;">
                <div>
                    <img
                        width="200"
                        height="27"
                        src="https://file.garden/aDx7rtkwXCXfZGMO/blinkies/blinkie-be-kind-to-ur-computer.gif"
                        alt="be kind to your computer"
                    />
                </div>
                <div>
                    <img
                        width="200"
                        height="27"
                        src="https://file.garden/aDx7rtkwXCXfZGMO/blinkies/blinkie-see-u-on-the-web.png"
                        alt="see u on the web"
                    />
                </div>
            </div>

            <p style="color: #999; font-size: 0.8rem; margin-top: 3rem;">last updated: 2026-02-19</p>
        </Mainframe>
    </Layout></body
>

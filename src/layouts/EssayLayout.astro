---
import Mainframe from "../components/Mainframe.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title> essay </title>
	</head>
	<body>
        <Mainframe buttons={["home", "essays"]}>
            <slot />
        </Mainframe>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0px;
		width: 100%;
		height: 100%;

		font-family: 'Fira Code', monospace;
	}
</style>
